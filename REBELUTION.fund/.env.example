# FUND - environment shape. NAMES AND PLACEHOLDERS ONLY.
#
# This file is COMMITTED and must never carry a real value. Copy it to
# .env.local (gitignored) for local work, and set the same names on the Railway
# service for a deployed build.
#
# NEXT_PUBLIC_* VALUES BAKE AT BUILD TIME. Setting one after a build has no
# effect until the next build - on Railway that means a redeploy, not a restart.
# Every variable below is public by design: they are shipped to the browser.
# NOTHING SECRET BELONGS IN THIS FILE OR IN .env.local. The service-role key in
# particular must never appear in either; it lives only in the Supabase
# dashboard.
#
# EVERY VALUE HERE IS EMPTY ON PURPOSE. ASTRA_STANDARD v1.0 section 8: every new
# env var gets a NAMED SETTER in a dispatch, and no value is ever written into a
# file or a report (the VOTE_INTERNAL_URL lesson, FRONT49).

# Where the app is mounted. Empty means the app roots at / (standalone).
# The proxied build under the manual sets this to the mount segment; it is
# required AT BUILD TIME, because basePath is baked into every asset URL.
NEXT_PUBLIC_BASE_PATH=

# Which record the app reads.
#   live  - the production give_* tables (schema identifiers are unchanged by
#           the GIVE -> FUND rename; FUND_MF v0.1, IDENTITY)
#   mock  - the fixtures in src/lib/provider.ts (local design work only)
# Anything other than "live" falls back to mock, so a typo yields the obviously
# fictional record rather than a half-configured live one. A production build
# REFUSES unless this is exactly "live" (scripts/build-guard.mjs).
NEXT_PUBLIC_DATA_SOURCE=mock

# The Supabase project the live record is read from.
NEXT_PUBLIC_SUPABASE_URL=

# The PUBLISHABLE anon key - the browser-shipped public key, not a secret.
# Legacy eyJ-format JWT: the sb_publishable_ format breaks supabase-js here.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Absolute origin for canonical URLs, og:url and the sitemap.
# UNSET IS A SUPPORTED STATE, not a degraded one: metadataBase becomes
# undefined, Next emits no absolute URLs, and every page renders exactly as it
# does with one set. Absolute canonicals appear the moment this is set and the
# service is rebuilt. See src/app/site-origin.ts.
NEXT_PUBLIC_SITE_ORIGIN=

# Stripe publishable key. Read by src/lib/pledge.ts.
# MUST come from the same sandbox as the fountain's STRIPE_SECRET_KEY.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
